# WhatsApp group — set ONE of these.
# From an invite link https://chat.whatsapp.com/AbCdEf123 the code is "AbCdEf123".
GROUP_INVITE_CODE=
# Or match the group by its exact name (bot's number must already be a member).
GROUP_NAME=

# IRCTC advance reservation period: booking opens this many days before the journey date (default 60).
# The bot messages the day BEFORE booking opens ("tomorrow is ticket opening").
NOTIFY_DAYS=60

# Minimum continuous off-days for a break to be announced (default 2)
MIN_BREAK_DAYS=2

# Daily check schedule (cron syntax) and timezone
CRON_SCHEDULE=0 9 * * *
TZ=Asia/Kolkata

# MongoDB connection string (MongoDB Atlas free M0 works). When set, the
# WhatsApp session, sent-notification state, group id and holiday calendars
# all live in MongoDB — required on Render's free tier (no disk).
# When empty, everything is stored as files under DATA_DIR (local dev).
MONGODB_URI=

# File storage location when MONGODB_URI is empty
DATA_DIR=./data

# HTTP port (Render sets PORT automatically)
PORT=3000

# Token required for POST /test (pick any secret string)
TEST_TOKEN=

# Login for the web pages (/status, /qr)
ADMIN_USER=admin
ADMIN_PASS=

# For local testing only: pretend today is this date (YYYY-MM-DD)
# FAKE_TODAY=2026-09-08
